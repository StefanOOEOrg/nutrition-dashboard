# Copy to .env and adjust. Real environment variables win over this file.

# libpq URL of the database that holds the mcp-nutrition schema (see the mcp-nutrition
# repository for the container). The dashboard only reads.
NUTRITION_DASHBOARD_DATABASE_URL=postgresql://nutrition:YOUR-PASSWORD@127.0.0.1:5433/nutrition

# Schema that holds meals/water/goals (default: nutrition)
# DASHBOARD_SCHEMA=nutrition

# Time zone for "today" and for the times in the log (default: Europe/Vienna)
# DASHBOARD_TZ=Europe/Vienna

# Where the UI listens. Keep 127.0.0.1: the page is meant to be reached through an SSH tunnel.
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8090
